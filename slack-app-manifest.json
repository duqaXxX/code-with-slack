{
  "display_information": {
    "name": "code-with-slack",
    "description": "Drive the Claude Code sessions on your own machine from private Slack channels. Powered by Claude.",
    "background_color": "#1f2328"
  },
  "features": {
    "bot_user": {
      "display_name": "code-with-slack",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "groups:history",
        "groups:read",
        "chat:write",
        "files:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
