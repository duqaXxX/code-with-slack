# Python and tool output. The tools' caches (.pytest_cache, .ruff_cache, .mypy_cache) also carry
# an ignore file of their own.
__pycache__/
*.py[cod]
/.venv/
/dist/
/build/
*.egg-info/
.coverage
htmlcov/

# Secrets. awaydesk reads its configuration from ~/.config/awaydesk/, never from
# the repository; these lines only catch a copy made here by mistake.
.env
.env.*

# Files a machine or an agent creates while working in the checkout.
.DS_Store
/.claude/settings.local.json
/.superpowers/

# Node.
/node_modules/
