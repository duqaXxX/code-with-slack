{
  "name": "awaydesk",
  "version": "0.1.0",
  "description": "Drive the Claude Code sessions on your own Mac from private Slack channels. Powered by Claude.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
